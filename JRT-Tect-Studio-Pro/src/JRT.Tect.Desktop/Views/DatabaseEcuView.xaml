<UserControl x:Class="JRT.Tect.Desktop.Views.DatabaseEcuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="#FFFFFF">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#15161D" BorderBrush="#00E5FF" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="🗄 MASTER ECU DATABASE MANAGEMENT SYSTEM" Foreground="#00E5FF" FontWeight="Bold" FontSize="14"/>
                    <TextBlock Text="Manajemen Data ECU, Pemilik Kendaraan, Spesifikasi Engine, dan Catatan Remap Tuning" Foreground="#A0AAB0" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Content="📥 Ekspor Database (JSON)" Background="#1E293B" Foreground="#47FF7A" FontWeight="Bold" Padding="12,6" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>

        <!-- INPUT FORM CARD -->
        <Border Grid.Row="1" Background="#15161D" BorderBrush="#222228" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="📝 FORM INPUT DATA ECU MANUAL" Foreground="#00E5FF" FontWeight="Bold" FontSize="12" Margin="0,0,0,12"/>
                <UniformGrid Columns="2" Margin="0,0,0,12">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Kode / Part Number ECU:" Foreground="#A0AAB0" FontSize="11"/>
                        <TextBox Text="{Binding PartNumberInput}" Height="28" Background="#06090F" Foreground="White" Margin="0,4,0,8" VerticalContentAlignment="Center"/>

                        <TextBlock Text="Nama Pemilik / Customer:" Foreground="#A0AAB0" FontSize="11"/>
                        <TextBox Text="{Binding CustomerInput}" Height="28" Background="#06090F" Foreground="White" Margin="0,4,0,0" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Margin="8,0,0,0">
                        <TextBlock Text="Model / Tipe Sepeda Motor:" Foreground="#A0AAB0" FontSize="11"/>
                        <TextBox Text="{Binding ModelNameInput}" Height="28" Background="#06090F" Foreground="White" Margin="0,4,0,8" VerticalContentAlignment="Center"/>

                        <TextBlock Text="Plat Nomor / No. Polisi:" Foreground="#A0AAB0" FontSize="11"/>
                        <TextBox Text="{Binding LicensePlateInput}" Height="28" Background="#06090F" Foreground="White" Margin="0,4,0,0" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </UniformGrid>
                <Button Content="💾 SIMPAN RECORD ECU KE DATABASE MASTER" Command="{Binding SaveRecordCommand}" Background="#00E5FF" Foreground="Black" FontWeight="ExtraBold" Padding="16,8" HorizontalAlignment="Left"/>
            </StackPanel>
        </Border>

        <!-- DATA GRID MASTER -->
        <Border Grid.Row="2" Background="#06090F" BorderBrush="#222228" BorderThickness="1" CornerRadius="8" Padding="12">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="📋 DAFTAR MASTER DATA ECU TERDAFTAR" Foreground="White" FontWeight="Bold" FontSize="12" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}" Width="240" Height="28" Background="#15161D" Foreground="White" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalContentAlignment="Center"/>
                </DockPanel>
                <DataGrid ItemsSource="{Binding EcuRecords}" AutoGenerateColumns="False" IsReadOnly="True" Background="#06090F" Foreground="White" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Part Number" Binding="{Binding PartNumber}" Width="140" Foreground="#FFD400"/>
                        <DataGridTextColumn Header="Model Motor" Binding="{Binding ModelName}" Width="*"/>
                        <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="140" Foreground="#00E5FF"/>
                        <DataGridTextColumn Header="Plat No" Binding="{Binding LicensePlate}" Width="100"/>
                        <DataGridTextColumn Header="BBM" Binding="{Binding FuelGrade}" Width="120" Foreground="#47FF7A"/>
                        <DataGridTextColumn Header="Catatan Remap" Binding="{Binding RemapNotes}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
