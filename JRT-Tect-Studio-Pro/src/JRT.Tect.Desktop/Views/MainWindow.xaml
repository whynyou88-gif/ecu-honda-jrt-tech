<Window x:Class="JRT.Tect.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:JRT.Tect.Desktop.ViewModels"
        Title="JRT Tech ANALIST Pro 3.4 — Honda ECU Remap Studio (Native WPF)" Height="840" Width="1300"
        Background="#0E0E10" Foreground="#FFFFFF"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/> <!-- Left Dark Sidebar -->
            <ColumnDefinition Width="*"/>   <!-- Main Content Area -->
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR NAVIGATION -->
        <Border Grid.Column="0" Background="#141417" BorderBrush="#FF5722" BorderThickness="0,0,2,0">
            <DockPanel>
                <!-- TOP BRANDING LOGO -->
                <Border DockPanel.Dock="Top" Padding="14,16" BorderBrush="#222226" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="32" Height="32" CornerRadius="6" Background="#FF5722" Margin="0,0,8,0">
                            <TextBlock Text="🏁" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="JRT TECH" Foreground="#FFFFFF" FontWeight="ExtraBold" FontSize="13"/>
                            <TextBlock Text="STUDIO PRO" Foreground="#FF5722" FontWeight="Bold" FontSize="10" Margin="0,-2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- SIDEBAR MENU BUTTONS -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Padding="8,12">
                        <StackPanel>
                            <!-- MAIN CATEGORY -->
                            <TextBlock Text="MAIN" Foreground="#66666E" FontWeight="Bold" FontSize="9" Margin="8,0,0,4"/>
                            <Button Content="🏠 Dashboard" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavigationTarget.Dashboard}" Background="Transparent" Foreground="White" HorizontalContentAlignment="Left" Padding="10,7" Margin="0,0,0,2" BorderThickness="0"/>
                            <Button Content="🏁 LIVE PERFORMANCE" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavigationTarget.LivePerformance}" Background="Transparent" Foreground="#FF5722" FontWeight="Bold" HorizontalContentAlignment="Left" Padding="10,7" Margin="0,0,0,12" BorderThickness="0"/>

                            <!-- DIAGNOSTICS CATEGORY -->
                            <TextBlock Text="DIAGNOSTICS" Foreground="#66666E" FontWeight="Bold" FontSize="9" Margin="8,0,0,4"/>
                            <Button Content="📈 Live Data" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavigationTarget.LiveData}" Background="Transparent" Foreground="#AAAAAA" HorizontalContentAlignment="Left" Padding="10,7" Margin="0,0,0,2" BorderThickness="0"/>
                            <Button Content="⚠️ Diagnostic DTC" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavigationTarget.Diagnostic}" Background="Transparent" Foreground="#AAAAAA" HorizontalContentAlignment="Left" Padding="10,7" Margin="0,0,0,12" BorderThickness="0"/>

                            <!-- TUNING CATEGORY -->
                            <TextBlock Text="TUNING" Foreground="#66666E" FontWeight="Bold" FontSize="9" Margin="8,0,0,4"/>
                            <Button Content="📊 Map Editor" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavigationTarget.MapEditor}" Background="Transparent" Foreground="#AAAAAA" HorizontalContentAlignment="Left" Padding="10,7" Margin="0,0,0,2" BorderThickness="0"/>
                            <Button Content="⚡ Dyno Test" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavigationTarget.DynoTest}" Background="Transparent" Foreground="#AAAAAA" HorizontalContentAlignment="Left" Padding="10,7" Margin="0,0,0,2" BorderThickness="0"/>
                            <Button Content="⚙️ Flash ECU" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavigationTarget.FlashEcu}" Background="Transparent" Foreground="#AAAAAA" HorizontalContentAlignment="Left" Padding="10,7" Margin="0,0,0,12" BorderThickness="0"/>

                            <!-- STORAGE & DB CATEGORY -->
                            <TextBlock Text="STORAGE &amp; DB" Foreground="#66666E" FontWeight="Bold" FontSize="9" Margin="8,0,0,4"/>
                            <Button Content="🗄️ Database ECU" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavigationTarget.DatabaseEcu}" Background="Transparent" Foreground="#AAAAAA" HorizontalContentAlignment="Left" Padding="10,7" Margin="0,0,0,12" BorderThickness="0"/>

                            <!-- SYSTEM CATEGORY -->
                            <TextBlock Text="SYSTEM" Foreground="#66666E" FontWeight="Bold" FontSize="9" Margin="8,0,0,4"/>
                            <Button Content="⚙️ Settings" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavigationTarget.Settings}" Background="Transparent" Foreground="#AAAAAA" HorizontalContentAlignment="Left" Padding="10,7" BorderThickness="0"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Column="1" Background="#0E0E10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Top Header Bar -->
                <RowDefinition Height="*"/>    <!-- View Host -->
            </Grid.RowDefinitions>

            <!-- TOP HEADER BAR -->
            <Border Grid.Row="0" Background="#141417" Padding="20,12" BorderBrush="#222226" BorderThickness="0,0,0,1">
                <DockPanel>
                    <TextBlock Text="{Binding CurrentPageTitle}" Foreground="#FFFFFF" FontWeight="ExtraBold" FontSize="18" VerticalAlignment="Center" DockPanel.Dock="Left"/>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ConnectionStatusText}" Foreground="#00E5FF" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0"/>

                        <ComboBox SelectedItem="{Binding SelectedPort}" Width="200" Height="30" Background="#1E1E24" Foreground="White" FontWeight="Bold" SelectedIndex="0" Margin="0,0,12,0" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="usbserial-4 (FTDI UART)"/>
                            <ComboBoxItem Content="COM3 - USB Serial Port"/>
                        </ComboBox>

                        <Button Content="🔌 Connect ECU" Command="{Binding ToggleConnectionCommand}" Background="#FF5722" Foreground="White" FontWeight="Bold" Padding="14,6"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- HOST FOR CACHED USERCONTROL VIEWS -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}" />
        </Grid>
    </Grid>
</Window>
