<Window x:Class="JRT.Tect.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JRT Tect ANALIST Pro 3.4 - Honda ECU Remap Studio (Native C#)" Height="850" Width="1380"
        Background="#121212" Foreground="#FFFFFF"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Navigation Banner -->
            <RowDefinition Height="*"/>    <!-- Main Module View Container -->
            <RowDefinition Height="Auto"/> <!-- Bottom Statusbar -->
        </Grid.RowDefinitions>

        <!-- TOP ORANGE BANNER & GLOBAL CONTROLS -->
        <Border Grid.Row="0" Background="#1E1E1E" Padding="10" BorderBrush="#FF6D00" BorderThickness="0,0,0,2">
            <DockPanel>
                <!-- Model Selector Dropdown -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="ECU MODEL:" Foreground="#FF6D00" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="ComboEcuModel" Width="280" Height="28" Background="#FF6D00" Foreground="White" FontWeight="Bold" SelectedIndex="0" Margin="0,0,20,0">
                        <ComboBoxItem Content="22 VARIO 125 OLD KZRA-601 (2013-2015)"/>
                        <ComboBoxItem Content="23 VARIO 150 NEW K59J-A01"/>
                        <ComboBoxItem Content="18 BEAT FI K25-901"/>
                        <ComboBoxItem Content="15 CB150R K15-901"/>
                        <ComboBoxItem Content="19 SCOOPY FI K16-901"/>
                        <ComboBoxItem Content="21 PCX 150 K97-N01"/>
                    </ComboBox>

                    <TextBlock Text="EDIT VALUE:" Foreground="#FF6D00" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="TxtEditValue" Width="60" Text="0.00" Background="#2A2A2A" Foreground="White" TextAlignment="Center" FontWeight="Bold" Padding="3" Margin="0,0,5,0"/>
                    <Button Content="-" Width="24" Height="24" Background="#FF6D00" Foreground="White" FontWeight="Bold" Margin="0,0,3,0"/>
                    <Button Content="+" Width="24" Height="24" Background="#FF6D00" Foreground="White" FontWeight="Bold" Margin="0,0,15,0"/>

                    <TextBlock Text="Breakpoint:" Foreground="#FF6D00" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Width="45" Text="1.00" Background="#2A2A2A" Foreground="White" TextAlignment="Center" FontWeight="Bold" Padding="3"/>
                </StackPanel>

                <!-- Branding Badge -->
                <Border DockPanel.Dock="Right" CornerRadius="4" Padding="12,4" HorizontalAlignment="Right">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF6D00" Offset="0.0"/>
                            <GradientStop Color="#CC0000" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="🏍 JRT TECT ANALIST Pro 3.4 (C# Native)" FontWeight="ExtraBold" FontSize="14" Foreground="White"/>
                </Border>
            </DockPanel>
        </Border>

        <!-- MAIN TABBED MODULE CONTAINER (FULL FEATURE SUITE) -->
        <TabControl Grid.Row="1" Background="#121212" BorderThickness="0" Margin="5">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="HeaderTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="White" FontWeight="Bold" FontSize="12" Padding="12,6"/>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Background" Value="#1E1E1E"/>
                    <Setter Property="Margin" Value="0,0,4,0"/>
                </Style>
            </TabControl.Resources>

            <!-- MODULE 1: MAP EDITOR (2D & 3D REMAP STUDIO) -->
            <TabItem Header="🗺️ MAP EDITOR">
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="240"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Control Panel -->
                    <Border Grid.Column="0" Background="#1A1A1A" BorderBrush="#333" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,10,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="DATA BASE MAP" Foreground="#FF6D00" FontWeight="ExtraBold" FontSize="11" Margin="0,0,0,6"/>
                                <ComboBox SelectedIndex="0" Background="#FF6D00" Foreground="White" FontWeight="Bold" Margin="0,0,0,10">
                                    <ComboBoxItem Content="Fuel Map 1 (Injection)"/>
                                    <ComboBoxItem Content="Ignition Map 1 (Timing)"/>
                                    <ComboBoxItem Content="RPM Limiter Table"/>
                                </ComboBox>

                                <Button Content="Connect ECM" Background="#FF6D00" Foreground="White" FontWeight="Bold" Padding="7" Margin="0,0,0,5"/>
                                <Button Content="Auto Live Map Data" Background="#FF6D00" Foreground="White" FontWeight="Bold" Padding="7" Margin="0,0,0,5"/>
                                <Button Content="❖ Graph 3D View" Foreground="White" FontWeight="ExtraBold" Padding="8" Margin="0,0,0,5">
                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FF6D00" Offset="0"/>
                                            <GradientStop Color="#CC0000" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Button.Background>
                                </Button>

                                <Button Content="OPEN File (.BIN)" Background="#FF6D00" Foreground="White" FontWeight="Bold" Padding="7" Margin="0,0,0,5"/>
                                <Button Content="SAVE Map" Background="#FF6D00" Foreground="White" FontWeight="Bold" Padding="7" Margin="0,0,0,5"/>
                                <Button Content="SAVE As File" Background="#FF6D00" Foreground="White" FontWeight="Bold" Padding="7" Margin="0,0,0,10"/>

                                <!-- Volume Silinder CC Calculator -->
                                <Border Background="#252525" BorderBrush="#444" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Volume Silinder ( CC )" Foreground="#FF6D00" FontWeight="Bold" FontSize="10" Margin="0,0,0,5"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="BORE" Foreground="#AAA" FontSize="9" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1" Text="52.4" Background="#111" Foreground="White" FontSize="9" Padding="2" Margin="2,0"/>
                                            <TextBlock Grid.Column="2" Text="X" Foreground="#AAA" FontSize="9" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="STROKE" Foreground="#AAA" FontSize="9" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                            <TextBox Grid.Column="4" Text="57.9" Background="#111" Foreground="White" FontSize="9" Padding="2" Margin="2,0"/>
                                            <Button Grid.Column="5" Content="Ok" Background="#FF6D00" Foreground="White" FontSize="9" FontWeight="Bold" Padding="4,2"/>
                                        </Grid>
                                        <TextBlock Text="Displacement: 124.8 cc" Foreground="#22C55E" FontWeight="Bold" FontSize="10" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Center Map Grid -->
                    <Border Grid.Column="1" Background="#141414" BorderBrush="#333" BorderThickness="1" CornerRadius="6" Padding="10">
                        <DataGrid AutoGenerateColumns="True" Background="Transparent" RowHeaderWidth="40" GridLinesVisibility="All" HeadersVisibility="All"/>
                    </Border>

                    <!-- Right Telemetry Panel -->
                    <Border Grid.Column="2" Background="#1A1A1A" BorderBrush="#333" BorderThickness="1" CornerRadius="6" Padding="10" Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="LIVE METERS" Foreground="#FF6D00" FontWeight="Bold" Margin="0,0,0,10"/>
                            <UniformGrid Columns="2">
                                <Border Background="#222" CornerRadius="4" Padding="6" Margin="2">
                                    <StackPanel HorizontalAlignment="Center"><TextBlock Text="RPM" Foreground="#FF6D00"/><TextBlock Text="1850" Foreground="White" FontWeight="Bold" FontSize="14"/></StackPanel>
                                </Border>
                                <Border Background="#222" CornerRadius="4" Padding="6" Margin="2">
                                    <StackPanel HorizontalAlignment="Center"><TextBlock Text="TPS" Foreground="#00E5FF"/><TextBlock Text="1.9 %" Foreground="White" FontWeight="Bold" FontSize="14"/></StackPanel>
                                </Border>
                                <Border Background="#222" CornerRadius="4" Padding="6" Margin="2">
                                    <StackPanel HorizontalAlignment="Center"><TextBlock Text="IGT" Foreground="#FF6D00"/><TextBlock Text="10.6 °" Foreground="White" FontWeight="Bold" FontSize="14"/></StackPanel>
                                </Border>
                                <Border Background="#222" CornerRadius="4" Padding="6" Margin="2">
                                    <StackPanel HorizontalAlignment="Center"><TextBlock Text="ECT" Foreground="#FF6D00"/><TextBlock Text="87.3 °C" Foreground="White" FontWeight="Bold" FontSize="14"/></StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- MODULE 2: DIAGNOSTIC & DTC READ/CLEAR -->
            <TabItem Header="🩺 DIAGNOSTIC &amp; DTC">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="🔍 READ DTC FAULT CODES" Background="#FF6D00" Foreground="White" FontWeight="Bold" Padding="10,6" Margin="0,0,10,0"/>
                        <Button Content="🧹 CLEAR DTC FAULT CODES" Background="#CC0000" Foreground="White" FontWeight="Bold" Padding="10,6"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" Background="#1A1A1A" AutoGenerateColumns="True" HeadersVisibility="Column"/>
                </Grid>
            </TabItem>

            <!-- MODULE 3: ECU FLASHING (ROM WRITE/READ) -->
            <TabItem Header="⚡ ECU FLASHING">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Border Grid.Row="0" Background="#1A1A1A" Padding="15" CornerRadius="6" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="ECU FLASH PIPELINE (KEIHIN &amp; SHINDENGEN K-LINE)" Foreground="#FF6D00" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="📂 SELECT ROM (.BIN)" Background="#333" Foreground="White" Padding="8,4" Margin="0,0,10,0"/>
                                <TextBlock Text="File Loaded: 38770-KZRA-601.bin (64 KB)" Foreground="#22C55E" VerticalAlignment="Center" FontWeight="Bold"/>
                            </StackPanel>
                            <ProgressBar Height="20" Value="0" Maximum="100" Background="#222" Foreground="#FF6D00" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="⚡ READ ECU ROM" Background="#FF6D00" Foreground="White" FontWeight="Bold" Padding="12,6" Margin="0,0,10,0"/>
                                <Button Content="🔥 WRITE FLASH ROM" Background="#CC0000" Foreground="White" FontWeight="Bold" Padding="12,6"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- MODULE 4: LIVE PERFORMANCE & DYNO SWEEP -->
            <TabItem Header="📈 LIVE DYNO">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#141414" CornerRadius="6" Padding="10">
                        <TextBlock Text="[LIVE DYNO HORSEPOWER &amp; TORQUE GRAPH]" Foreground="#FF6D00" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="16"/>
                    </Border>
                    <Border Grid.Column="1" Background="#1A1A1A" CornerRadius="6" Padding="10" Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="DYNO CONTROL" Foreground="#FF6D00" FontWeight="Bold" Margin="0,0,0,10"/>
                            <Button Content="▶ START DYNO SWEEP" Background="#22C55E" Foreground="White" FontWeight="Bold" Padding="10,8" Margin="0,0,0,5"/>
                            <Button Content="⏹ STOP DYNO" Background="#CC0000" Foreground="White" FontWeight="Bold" Padding="10,8"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- MODULE 5: FILE MANAGER & BACKUPS -->
            <TabItem Header="📂 FILE MANAGER">
                <Grid Margin="10">
                    <DataGrid Background="#1A1A1A" AutoGenerateColumns="True"/>
                </Grid>
            </TabItem>

            <!-- MODULE 6: K-LINE PACKET TERMINAL -->
            <TabItem Header="📟 TERMINAL">
                <Grid Margin="10">
                    <TextBox Background="#0A0A0A" Foreground="#00FF00" FontFamily="Consolas" FontSize="12" Text="[00:00:01] K-Line Bus Initialized (10400 bps)...&#10;[00:00:02] TX: FE 04 72 8C&#10;[00:00:02] RX: 72 05 00 F0 99 (KWP2000 OK)" IsReadOnly="True" VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </TabItem>

            <!-- MODULE 7: SETTINGS & HARDWARE CONFIG -->
            <TabItem Header="⚙️ SETTINGS">
                <Grid Margin="20">
                    <StackPanel Width="400" HorizontalAlignment="Left">
                        <TextBlock Text="COM PORT:" Foreground="#FF6D00" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ComboBox SelectedIndex="0" Margin="0,0,0,15">
                            <ComboBoxItem Content="COM3 - USB Serial (FTDI)"/>
                            <ComboBoxItem Content="COM4 - CH340 Seri"/>
                        </ComboBox>

                        <TextBlock Text="BAUD RATE:" Foreground="#FF6D00" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ComboBox SelectedIndex="0" Margin="0,0,0,15">
                            <ComboBoxItem Content="10400 bps (Honda K-Line)"/>
                            <ComboBoxItem Content="38400 bps"/>
                        </ComboBox>

                        <Button Content="💾 SAVE CONFIGURATION" Background="#FF6D00" Foreground="White" FontWeight="Bold" Padding="10,6"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- BOTTOM STATUS BAR -->
        <Border Grid.Row="2" Background="#181818" Padding="10,5" BorderBrush="#333" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock Text="ECU Status: Connected | Port: COM3 (10400 bps) | Target: Keihin 37820-KZRA-601" Foreground="#888" FontSize="11" DockPanel.Dock="Left"/>
                <TextBlock Text="JRT Tech ANALIST Pro v3.4 Native C#" Foreground="#FF6D00" FontWeight="Bold" FontSize="11" DockPanel.Dock="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
