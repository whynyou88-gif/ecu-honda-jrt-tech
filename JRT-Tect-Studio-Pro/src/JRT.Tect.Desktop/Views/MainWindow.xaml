<Window x:Class="JRT.Tect.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JRT Tech ANALIST Pro 3.4 — Honda ECU Remap Studio" Height="820" Width="1280"
        Background="#0E0E10" Foreground="#FFFFFF"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/> <!-- Left Dark Sidebar -->
            <ColumnDefinition Width="*"/>   <!-- Main Content Area -->
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR NAVIGATION -->
        <Border Grid.Column="0" Background="#141417" BorderBrush="#FF4500" BorderThickness="0,0,2,0">
            <DockPanel>
                <!-- TOP BRANDING LOGO -->
                <Border DockPanel.Dock="Top" Padding="15,18" BorderBrush="#222226" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="6" Background="#FF4500" Margin="0,0,10,0">
                            <TextBlock Text="🏁" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="JRT TECH" Foreground="#FFFFFF" FontWeight="ExtraBold" FontSize="14"/>
                            <TextBlock Text="STUDIO PRO" Foreground="#FF4500" FontWeight="Bold" FontSize="11" Margin="0,-2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- SIDEBAR MENU ITEMS -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Padding="10,15">
                        <StackPanel>
                            <!-- MAIN CATEGORY -->
                            <TextBlock Text="MAIN" Foreground="#66666E" FontWeight="Bold" FontSize="10" Margin="10,0,0,6"/>
                            <RadioButton x:Name="NavDashboard" Content="🏠  Dashboard" IsChecked="True" Background="#FF4500" Foreground="White" FontWeight="Bold" Padding="10,8" Margin="0,0,0,4"/>
                            <Button x:Name="NavLivePerformance" Content="🏁  LIVE PERFORMANCE" Background="Transparent" Foreground="#AAAAAA" HorizontalContentAlignment="Left" Padding="10,8" Margin="0,0,0,15" BorderThickness="0"/>

                            <!-- DIAGNOSTICS CATEGORY -->
                            <TextBlock Text="DIAGNOSTICS" Foreground="#66666E" FontWeight="Bold" FontSize="10" Margin="10,0,0,6"/>
                            <Button x:Name="NavLiveData" Content="📈  Live Data" Background="Transparent" Foreground="#AAAAAA" HorizontalContentAlignment="Left" Padding="10,8" Margin="0,0,0,4" BorderThickness="0"/>
                            <DockPanel Margin="0,0,0,15">
                                <Border DockPanel.Dock="Right" Background="#FF4500" CornerRadius="10" Padding="6,1" Margin="0,0,10,0">
                                    <TextBlock Text="0" Foreground="White" FontWeight="Bold" FontSize="10"/>
                                </Border>
                                <Button x:Name="NavDiagnostic" Content="⚠️  Diagnostic" Background="Transparent" Foreground="#AAAAAA" HorizontalContentAlignment="Left" Padding="10,8" BorderThickness="0"/>
                            </DockPanel>

                            <!-- TUNING CATEGORY -->
                            <TextBlock Text="TUNING" Foreground="#66666E" FontWeight="Bold" FontSize="10" Margin="10,0,0,6"/>
                            <Button x:Name="NavMapEditor" Content="📊  Map Editor" Background="Transparent" Foreground="#AAAAAA" HorizontalContentAlignment="Left" Padding="10,8" Margin="0,0,0,4" BorderThickness="0"/>
                            <Button x:Name="NavDynoTest" Content="⚡  Dyno Test" Background="Transparent" Foreground="#AAAAAA" HorizontalContentAlignment="Left" Padding="10,8" Margin="0,0,0,4" BorderThickness="0"/>
                            <Button x:Name="NavFlashEcu" Content="⚙️  Flash ECU" Background="Transparent" Foreground="#AAAAAA" HorizontalContentAlignment="Left" Padding="10,8" Margin="0,0,0,15" BorderThickness="0"/>

                            <!-- STORAGE & DB CATEGORY -->
                            <TextBlock Text="STORAGE &amp; DB" Foreground="#66666E" FontWeight="Bold" FontSize="10" Margin="10,0,0,6"/>
                            <Button x:Name="NavDatabaseEcu" Content="🗄️  Database ECU" Background="Transparent" Foreground="#AAAAAA" HorizontalContentAlignment="Left" Padding="10,8" Margin="0,0,0,4" BorderThickness="0"/>
                            <Button x:Name="NavBackup" Content="💾  Backup" Background="Transparent" Foreground="#AAAAAA" HorizontalContentAlignment="Left" Padding="10,8" Margin="0,0,0,4" BorderThickness="0"/>
                            <Button x:Name="NavRestore" Content="🔄  Restore" Background="Transparent" Foreground="#AAAAAA" HorizontalContentAlignment="Left" Padding="10,8" Margin="0,0,0,4" BorderThickness="0"/>
                            <Button x:Name="NavFileManager" Content="📁  File Manager" Background="Transparent" Foreground="#AAAAAA" HorizontalContentAlignment="Left" Padding="10,8" Margin="0,0,0,15" BorderThickness="0"/>

                            <!-- TOOLS CATEGORY -->
                            <TextBlock Text="TOOLS" Foreground="#66666E" FontWeight="Bold" FontSize="10" Margin="10,0,0,6"/>
                            <Button x:Name="NavTerminal" Content="📟  Terminal" Background="Transparent" Foreground="#AAAAAA" HorizontalContentAlignment="Left" Padding="10,8" Margin="0,0,0,4" BorderThickness="0"/>
                            <Button x:Name="NavLogs" Content="📑  Logs" Background="Transparent" Foreground="#AAAAAA" HorizontalContentAlignment="Left" Padding="10,8" Margin="0,0,0,15" BorderThickness="0"/>

                            <!-- SYSTEM CATEGORY -->
                            <TextBlock Text="SYSTEM" Foreground="#66666E" FontWeight="Bold" FontSize="10" Margin="10,0,0,6"/>
                            <Button x:Name="NavSettings" Content="⚙️  Settings" Background="Transparent" Foreground="#AAAAAA" HorizontalContentAlignment="Left" Padding="10,8" Margin="0,0,0,4" BorderThickness="0"/>
                            <Button x:Name="NavAbout" Content="ℹ️  About" Background="Transparent" Foreground="#AAAAAA" HorizontalContentAlignment="Left" Padding="10,8" BorderThickness="0"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Column="1" Background="#0E0E10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Top Header Bar -->
                <RowDefinition Height="*"/>    <!-- View Host -->
            </Grid.RowDefinitions>

            <!-- TOP HEADER BAR -->
            <Border Grid.Row="0" Background="#141417" Padding="20,12" BorderBrush="#222226" BorderThickness="0,0,0,1">
                <DockPanel>
                    <TextBlock x:Name="TxtPageTitle" Text="Dashboard" Foreground="#FFFFFF" FontWeight="ExtraBold" FontSize="18" VerticalAlignment="Center" DockPanel.Dock="Left"/>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ComboBox x:Name="ComboPort" Width="220" Height="32" Background="#1E1E24" Foreground="White" FontWeight="Bold" SelectedIndex="0" Margin="0,0,12,0" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="usbserial-4 (FTDI UART)"/>
                            <ComboBoxItem Content="COM3 - USB Serial Port"/>
                        </ComboBox>

                        <Button Content="🔌 Connect ECU" Background="#FF4500" Foreground="White" FontWeight="Bold" Padding="14,6" Margin="0,0,12,0"/>
                        <Button Content="⏻" Background="#1E1E24" Foreground="White" Width="32" Height="32" Margin="0,0,6,0"/>
                        <Button Content="⚙" Background="#1E1E24" Foreground="White" Width="32" Height="32" Margin="0,0,6,0"/>
                        <Button Content="📱" Background="#1E1E24" Foreground="White" Width="32" Height="32"/>
                    </StackPanel>
                </DockPanel>
            </Border>


            <!-- MAIN DASHBOARD CONTENT VIEW -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
                <StackPanel>
                    <!-- TOP 4 STAT CARDS GRID -->
                    <UniformGrid Columns="4" Margin="0,0,0,15">
                        <!-- UPTIME CARD -->
                        <Border Background="#16161A" BorderBrush="#222226" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,10,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="⏱  SYSTEM UPTIME" Foreground="#888894" FontWeight="Bold" FontSize="11"/>
                                </StackPanel>
                                <TextBlock Text="3h 55m 38s" Foreground="#FFFFFF" FontWeight="ExtraBold" FontSize="22"/>
                            </StackPanel>
                        </Border>

                        <!-- VOLTAGE CARD -->
                        <Border Background="#16161A" BorderBrush="#222226" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,10,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="⚡  BATTERY VOLTAGE" Foreground="#888894" FontWeight="Bold" FontSize="11"/>
                                </StackPanel>
                                <TextBlock Text="0.00 V" Foreground="#FFFFFF" FontWeight="ExtraBold" FontSize="22"/>
                            </StackPanel>
                        </Border>

                        <!-- CONNECTION CARD -->
                        <Border Background="#16161A" BorderBrush="#222226" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,10,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="⚙  ECU CONNECTION" Foreground="#888894" FontWeight="Bold" FontSize="11"/>
                                </StackPanel>
                                <TextBlock Text="Disconnected" Foreground="#EF4444" FontWeight="ExtraBold" FontSize="22"/>
                            </StackPanel>
                        </Border>

                        <!-- CPU TEMP CARD -->
                        <Border Background="#16161A" BorderBrush="#222226" BorderThickness="1" CornerRadius="8" Padding="15">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="🌡  CPU TEMP" Foreground="#888894" FontWeight="Bold" FontSize="11"/>
                                </StackPanel>
                                <TextBlock Text="0.0 °C" Foreground="#FFFFFF" FontWeight="ExtraBold" FontSize="22"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- CENTER GAUGE CONTAINER CARD -->
                    <Border Background="#16161A" BorderBrush="#222226" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,15">
                        <StackPanel HorizontalAlignment="Center">
                            <!-- LED SHIFT LIGHT DOTS -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                                <Ellipse Width="12" Height="12" Fill="#33333C" Margin="4,0"/>
                                <Ellipse Width="12" Height="12" Fill="#33333C" Margin="4,0"/>
                                <Ellipse Width="12" Height="12" Fill="#33333C" Margin="4,0"/>
                                <Ellipse Width="12" Height="12" Fill="#33333C" Margin="4,0"/>
                                <Ellipse Width="12" Height="12" Fill="#33333C" Margin="4,0"/>
                                <Ellipse Width="12" Height="12" Fill="#33333C" Margin="4,0"/>
                                <Ellipse Width="12" Height="12" Fill="#33333C" Margin="4,0"/>
                                <Ellipse Width="12" Height="12" Fill="#33333C" Margin="4,0"/>
                                <Ellipse Width="12" Height="12" Fill="#33333C" Margin="4,0"/>
                            </StackPanel>

                            <!-- CIRCULAR TACHOMETER RPM GAUGE -->
                            <Grid Width="260" Height="220">
                                <Ellipse Width="220" Height="220" Stroke="#26262E" StrokeThickness="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Ellipse Width="220" Height="220" Stroke="#FF4500" StrokeThickness="10" StrokeDashArray="3 1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,20,0,0">
                                    <TextBlock Text="0" Foreground="#FFFFFF" FontWeight="ExtraBold" FontSize="38" HorizontalAlignment="Center"/>
                                    <TextBlock Text="RPM" Foreground="#FF4500" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Text="0" Foreground="#AAA" FontSize="11" Margin="40,160,0,0"/>
                                <TextBlock Text="2" Foreground="#AAA" FontSize="11" Margin="25,100,0,0"/>
                                <TextBlock Text="4" Foreground="#AAA" FontSize="11" Margin="45,45,0,0"/>
                                <TextBlock Text="6" Foreground="#AAA" FontSize="11" Margin="125,25,0,0"/>
                                <TextBlock Text="8" Foreground="#AAA" FontSize="11" Margin="200,45,0,0"/>
                                <TextBlock Text="10" Foreground="#AAA" FontSize="11" Margin="220,100,0,0"/>
                                <TextBlock Text="12" Foreground="#AAA" FontSize="11" Margin="200,160,0,0"/>
                            </Grid>

                            <!-- BOTTOM 3 METRICS GRID -->
                            <Grid Width="650" Margin="0,15,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- SPEED METRIC -->
                                <Border Grid.Column="0" Background="#1C1C22" BorderBrush="#2A2A32" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="5">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="SPEED" Foreground="#888894" FontSize="10" FontWeight="Bold"/>
                                        <TextBlock Text="0 KM/H" Foreground="#FFFFFF" FontSize="16" FontWeight="ExtraBold" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- THROTTLE (TPS) METRIC -->
                                <Border Grid.Column="1" Background="#1C1C22" BorderBrush="#2A2A32" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="5">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="THROTTLE (TPS)" Foreground="#888894" FontSize="10" FontWeight="Bold"/>
                                        <TextBlock Text="0.0 %" Foreground="#FF4500" FontSize="16" FontWeight="ExtraBold" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- ENGINE TEMP METRIC -->
                                <Border Grid.Column="2" Background="#1C1C22" BorderBrush="#2A2A32" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="5">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="ENGINE TEMP" Foreground="#888894" FontSize="10" FontWeight="Bold"/>
                                        <TextBlock Text="30.0 °C" Foreground="#FF4500" FontSize="16" FontWeight="ExtraBold" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- BOTTOM 2 CARDS GRID -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- STORAGE USAGE CARD -->
                        <Border Grid.Column="0" Background="#16161A" BorderBrush="#222226" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,10,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="🗄️  STORAGE USAGE" Foreground="#888894" FontWeight="Bold" FontSize="11"/>
                                </StackPanel>
                                <TextBlock Text="10% used (100.0 KB / 1.00 MB)" Foreground="#CCCCCC" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- RACING DEMO CARD -->
                        <Border Grid.Column="1" Background="#16161A" BorderBrush="#222226" BorderThickness="1" CornerRadius="8" Padding="15">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="👓  🎮 RACING DEMO (UI TEST ONLY)" Foreground="#888894" FontWeight="Bold" FontSize="11"/>
                                </StackPanel>
                                <TextBlock Text="Animasi tachometer sweep &amp; LED shift light. BUKAN data ECU asli." Foreground="#888894" FontSize="11" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="▶ Test Racing Demo" Background="#FF4500" Foreground="White" FontWeight="Bold" Padding="10,6" Margin="0,0,8,0"/>
                                    <Button Content="🕹 Sim Mode" Background="#262630" Foreground="White" FontWeight="Bold" Padding="10,6"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
