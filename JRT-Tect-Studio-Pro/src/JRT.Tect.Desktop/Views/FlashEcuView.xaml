<UserControl x:Class="JRT.Tect.Desktop.Views.FlashEcuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="#FFFFFF">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>
            <UniformGrid Columns="2" Margin="0,0,0,20">
                <!-- STEP 1: FILE BIN SELECTION -->
                <Border Background="#15161D" BorderBrush="#222228" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="1 📁 Pilih File BIN Remap / Kalibrasi" Foreground="#00E5FF" FontWeight="Bold" FontSize="13" Margin="0,0,0,12"/>
                        <Border Background="#06090F" BorderBrush="#00E5FF" BorderThickness="1" CornerRadius="6" Padding="20" Height="100" Margin="0,0,0,12">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="📁 Browse File BIN..." Foreground="#00E5FF" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                                <TextBlock Text="File kalibrasi ECU (.bin / .hex)" Foreground="#A0AAB0" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Active Buffer:" Foreground="#A0AAB0" FontSize="11"/>
                        <TextBlock Text="{Binding SelectedBinFile}" Foreground="#47FF7A" FontWeight="Bold" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- STEP 2: SECURITY & MODE -->
                <Border Background="#15161D" BorderBrush="#222228" BorderThickness="1" CornerRadius="8" Padding="18">
                    <StackPanel>
                        <TextBlock Text="2 🛡 Pengaturan Keamanan &amp; Mode Flash" Foreground="#00E5FF" FontWeight="Bold" FontSize="13" Margin="0,0,0,12"/>
                        <CheckBox Content="Synchronous Auto-backup sebelum write (Sangat Direkomendasikan)" IsChecked="{Binding AutoBackupBeforeWrite}" Foreground="#FFD400" Margin="0,0,0,12"/>
                        <CheckBox Content="Dry-Run Simulation Mode (Uji coba validasi tanpa hapus memori fisik)" IsChecked="{Binding DryRunSimulationMode}" Foreground="#A0AAB0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- STEP 3: EXECUTION & PROGRESS -->
            <Border Background="#15161D" BorderBrush="#FF5722" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel>
                    <TextBlock Text="3 ⚡ Jalankan Eksekusi Flash ECU" Foreground="#FF5722" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>
                    <ProgressBar Value="{Binding FlashProgressPct}" Height="18" Foreground="#FF5722" Background="#06090F" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding FlashStatusText}" Foreground="#47FF7A" FontWeight="Bold" FontSize="12" Margin="0,0,0,16"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="⚡ WRITE CALIBRATION MAP (ECU REMAP)" Command="{Binding WriteCalibrationCommand}" Background="#D32F2F" Foreground="White" FontWeight="ExtraBold" Padding="20,10" Margin="0,0,12,0"/>
                        <Button Content="🛑 CANCEL FLASH" Command="{Binding CancelFlashCommand}" Background="#1E293B" Foreground="White" Padding="16,10"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
