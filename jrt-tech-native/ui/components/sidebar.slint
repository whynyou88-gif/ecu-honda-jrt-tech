// ============================================================
// sidebar.slint — Navigation Sidebar Component
// ============================================================

import { Theme } from "../theme.slint";

export component SidebarItem inherits Rectangle {
    in property <string> text;
    in property <string> icon-text;
    in property <bool> active: false;
    in property <int> badge-count: 0;
    callback clicked();

    height: 36px;
    background: active ? Theme.accent-glow : (touch.has-hover ? Theme.bg-glass : transparent);
    border-radius: Theme.corner-radius-sm;

    if active : Rectangle {
        x: 0;
        width: 3px;
        height: parent.height;
        background: Theme.accent-orange;
        border-radius: 1px;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        alignment: center;

        Text {
            text: root.icon-text;
            font-size: 14px;
            color: root.active ? Theme.accent-orange : (touch.has-hover ? Theme.text-primary : Theme.text-secondary);
            vertical-alignment: center;
        }

        Text {
            text: root.text;
            font-size: 12px;
            font-weight: root.active ? 600 : 400;
            color: root.active ? Theme.text-primary : (touch.has-hover ? Theme.text-primary : Theme.text-secondary);
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        if root.badge-count > 0 : Rectangle {
            width: 20px;
            height: 16px;
            background: Theme.accent-orange;
            border-radius: 8px;

            Text {
                text: root.badge-count;
                font-size: 10px;
                font-weight: 700;
                color: #FFFFFF;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

export component Sidebar inherits Rectangle {
    in property <int> current-page: 0;
    in property <int> dtc-count: 0;
    callback page-changed(int);

    width: Theme.sidebar-width;
    background: Theme.bg-secondary;

    // Top racing stripe accent
    Rectangle {
        x: 0; y: 0;
        width: parent.width; height: 3px;
        background: Theme.accent-orange;
    }

    VerticalLayout {
        padding: 10px;
        spacing: 4px;

        // Logo Section
        HorizontalLayout {
            padding-top: 6px;
            padding-bottom: 12px;
            spacing: 8px;
            alignment: center;

            Rectangle {
                width: 32px; height: 32px;
                background: Theme.accent-orange;
                border-radius: 6px;

                Text {
                    text: "JRT";
                    font-size: 11px;
                    font-weight: 900;
                    color: #FFFFFF;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 0;

                Text {
                    text: "JRT TECH";
                    font-size: 11px;
                    font-weight: 800;
                    color: Theme.text-primary;
                }
                Text {
                    text: "STUDIO PRO";
                    font-size: 9px;
                    font-weight: 500;
                    color: Theme.accent-orange;
                }
            }
        }

        // Section: MAIN
        Text { text: "MAIN"; font-size: 9px; font-weight: 700; color: Theme.text-muted; padding-left: 6px; }

        SidebarItem {
            text: "Dashboard";
            icon-text: "📊";
            active: root.current-page == 0;
            clicked => { root.page-changed(0); }
        }

        SidebarItem {
            text: "LIVE Cluster";
            icon-text: "🏁";
            active: root.current-page == 1;
            clicked => { root.page-changed(1); }
        }

        // Section: DIAGNOSTICS
        Text { text: "DIAGNOSTICS"; font-size: 9px; font-weight: 700; color: Theme.text-muted; padding-left: 6px; }

        SidebarItem {
            text: "Live Telemetry";
            icon-text: "📈";
            active: root.current-page == 2;
            clicked => { root.page-changed(2); }
        }

        SidebarItem {
            text: "Diagnostic DTC";
            icon-text: "⚠️";
            active: root.current-page == 3;
            badge-count: root.dtc-count;
            clicked => { root.page-changed(3); }
        }

        // Section: TUNING
        Text { text: "TUNING"; font-size: 9px; font-weight: 700; color: Theme.text-muted; padding-left: 6px; }

        SidebarItem {
            text: "Map Editor";
            icon-text: "🗺️";
            active: root.current-page == 4;
            clicked => { root.page-changed(4); }
        }

        SidebarItem {
            text: "Dyno Test";
            icon-text: "⚡";
            active: root.current-page == 5;
            clicked => { root.page-changed(5); }
        }

        SidebarItem {
            text: "Flash ECU";
            icon-text: "💾";
            active: root.current-page == 6;
            clicked => { root.page-changed(6); }
        }

        // Section: DATABASE
        Text { text: "STORAGE & DB"; font-size: 9px; font-weight: 700; color: Theme.text-muted; padding-left: 6px; }

        SidebarItem {
            text: "ECU Database";
            icon-text: "🗄️";
            active: root.current-page == 7;
            clicked => { root.page-changed(7); }
        }

        SidebarItem {
            text: "Backup & Restore";
            icon-text: "📁";
            active: root.current-page == 8;
            clicked => { root.page-changed(8); }
        }

        SidebarItem {
            text: "Terminal Logs";
            icon-text: "💻";
            active: root.current-page == 9;
            clicked => { root.page-changed(9); }
        }
    }
}
